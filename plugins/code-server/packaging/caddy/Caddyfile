{
	admin off
	auto_https off
}

:9090 {
	tls /etc/cockpit/ws-certs.d/0-self-signed.cert /etc/cockpit/ws-certs.d/0-self-signed.key

	@code_server path_regexp cs ^/code-server/(?P<uid>[0-9]+)(?P<rest>/.*)?$
	handle @code_server {
		rewrite {re.cs.rest}
		reverse_proxy unix//run/code-server/{re.cs.uid}/code-server.sock
	}

	handle {
		reverse_proxy unix//run/cockpit/cockpit.sock
	}
}
